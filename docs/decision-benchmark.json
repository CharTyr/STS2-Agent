{
  "schema_version": 1,
  "title": "STS2 decision-quality offline benchmark v1",
  "cases": [
    {
      "id": "combat-lethal-before-end-turn",
      "kind": "combat",
      "title": "Take an exposed lethal instead of ending a live combat turn",
      "state": {
        "screen": "COMBAT",
        "available_actions": ["play_card", "end_turn"],
        "combat": {
          "action_readiness": {"can_use_combat_actions": true},
          "end_turn_will_kill_player": true,
          "lethal_risks": [
            {"enemy_index": 1, "damage_needed": 6, "source": "hand"}
          ],
          "enemies": [
            {"index": 0, "current_hp": 24, "intents": [{"total_damage": 12}]},
            {"index": 1, "current_hp": 6, "intents": [{"total_damage": 18}]}
          ],
          "hand": [
            {"index": 2, "card_id": "STRIKE", "requires_target": true, "valid_target_indices": [0, 1]}
          ]
        }
      },
      "expectations": [
        {"id": "fixture-is-actionable", "kind": "state_path", "path": "combat.action_readiness.can_use_combat_actions", "equals": true, "points": 0.25},
        {"id": "fixture-has-lethal", "kind": "state_path", "path": "combat.end_turn_will_kill_player", "equals": true, "points": 0.25},
        {"id": "do-not-end-turn-into-lethal", "kind": "forbid_action", "action": "end_turn", "points": 2},
        {"id": "use-a-combat-action", "kind": "action", "action": "play_card", "points": 2}
      ],
      "evidence": [
        "Strategy Rules §Combat: end_turn_will_kill_player forbids ending the turn when a defensive or lethal line exists.",
        "Strategy Rules §Combat: consume combat.lethal_risks before ordinary damage planning."
      ]
    },
    {
      "id": "combat-wait-when-gated",
      "kind": "combat",
      "title": "Do not issue a card action while the combat gate is closed",
      "state": {
        "screen": "COMBAT",
        "available_actions": ["discard_potion"],
        "combat": {
          "action_readiness": {"can_use_combat_actions": false, "reason": "player_actions_disabled"},
          "hand": [{"index": 0, "card_id": "STRIKE"}]
        }
      },
      "expectations": [
        {"id": "fixture-is-gated", "kind": "state_path", "path": "combat.action_readiness.can_use_combat_actions", "equals": false, "points": 0.5},
        {"id": "do-not-play-during-gate", "kind": "forbid_action", "action": "play_card", "points": 2},
        {"id": "do-not-end-turn-during-gate", "kind": "forbid_action", "action": "end_turn", "points": 2}
      ],
      "evidence": [
        "SKILL.md: action_readiness decides act versus wait before any card choice.",
        "The action surface deliberately omits play_card and end_turn while player actions are disabled."
      ]
    },
    {
      "id": "event-reject-lethal-option",
      "kind": "event",
      "title": "Avoid an event option whose payload says it will kill the player",
      "state": {
        "screen": "EVENT",
        "available_actions": ["choose_event_option"],
        "event": {
          "event_id": "BENCHMARK_EVENT",
          "options": [
            {"index": 0, "label": "Proceed", "is_locked": false, "is_proceed": true, "will_kill_player": false},
            {"index": 1, "label": "Fatal bargain", "is_locked": false, "is_proceed": false, "will_kill_player": true}
          ]
        }
      },
      "expectations": [
        {"id": "choose-an-event-option", "kind": "action", "action": "choose_event_option", "points": 1},
        {"id": "choose-safe-proceed", "kind": "option_action", "action": "choose_event_option", "option_index": 0, "points": 3}
      ],
      "evidence": [
        "Strategy Rules §Event: will_kill_player overrides all reward heuristics.",
        "Screen Playbooks §Event: only choose indices currently exposed by event.options."
      ]
    },
    {
      "id": "event-reject-locked-option",
      "kind": "event",
      "title": "Do not send a known locked event option",
      "state": {
        "screen": "EVENT",
        "available_actions": ["choose_event_option"],
        "event": {
          "event_id": "BENCHMARK_LOCKED_EVENT",
          "options": [
            {"index": 0, "label": "Locked", "is_locked": true, "is_proceed": false, "will_kill_player": false},
            {"index": 2, "label": "Safe option", "is_locked": false, "is_proceed": false, "will_kill_player": false}
          ]
        }
      },
      "expectations": [
        {"id": "choose-event-action", "kind": "action", "action": "choose_event_option", "points": 1},
        {"id": "choose-unlocked-index", "kind": "option_action", "action": "choose_event_option", "option_index": 2, "points": 3}
      ],
      "evidence": [
        "Screen Playbooks §Event: index 0 is often locked, so available_actions is not permission to pick it.",
        "Strategy Rules §Event: skip options whose is_locked flag is true."
      ]
    },
    {
      "id": "map-low-health-avoid-elite",
      "kind": "map",
      "title": "Low health should not select the exposed Elite branch",
      "state": {
        "screen": "MAP",
        "available_actions": ["choose_map_node"],
        "run": {"current_hp": 24, "max_hp": 80, "gold": 95},
        "map": {
          "available_nodes": [
            {"index": 0, "room_type": "Elite", "children": [4]},
            {"index": 1, "room_type": "Rest", "children": [3, 4]}
          ]
        }
      },
      "expectations": [
        {"id": "choose-map-action", "kind": "action", "action": "choose_map_node", "points": 1},
        {"id": "take-rest-branch", "kind": "option_action", "action": "choose_map_node", "option_index": 1, "points": 3}
      ],
      "evidence": [
        "Strategy Rules §Route: below roughly 45% health prefer Rest over Elite.",
        "The Rest branch also preserves two children, so it does not sacrifice option value."
      ]
    },
    {
      "id": "map-healthy-elite-value",
      "kind": "map",
      "title": "Healthy run may take an Elite when alternatives are otherwise comparable",
      "state": {
        "screen": "MAP",
        "available_actions": ["choose_map_node"],
        "run": {"current_hp": 62, "max_hp": 80, "gold": 140},
        "map": {
          "available_nodes": [
            {"index": 0, "room_type": "Elite", "children": [3, 4]},
            {"index": 1, "room_type": "Monster", "children": [3]}
          ]
        }
      },
      "expectations": [
        {"id": "choose-map-action", "kind": "action", "action": "choose_map_node", "points": 1},
        {"id": "take-elite-when-healthy", "kind": "option_action", "action": "choose_map_node", "option_index": 0, "points": 3}
      ],
      "evidence": [
        "Strategy Rules §Route: above roughly 65% health Elites are the best map value; this fixture is 77.5%.",
        "The Elite branch has no lower future optionality than the hallway branch."
      ]
    },
    {
      "id": "rest-low-health-heal",
      "kind": "rest",
      "title": "Heal rather than smith at low health before an unknown next node",
      "state": {
        "screen": "REST",
        "available_actions": ["choose_rest_option"],
        "run": {"current_hp": 28, "max_hp": 80},
        "rest": {
          "options": [
            {"index": 0, "option_id": "REST", "is_enabled": true},
            {"index": 1, "option_id": "SMITH", "is_enabled": true}
          ]
        }
      },
      "expectations": [
        {"id": "choose-rest-action", "kind": "action", "action": "choose_rest_option", "points": 1},
        {"id": "heal-low-health", "kind": "option_action", "action": "choose_rest_option", "option_index": 0, "points": 3}
      ],
      "evidence": [
        "Strategy Rules §Rest: heal below about 50% current_hp/max_hp unless an exceptional smith line is evidenced.",
        "No exceptional card-upgrade evidence is supplied, so this fixture does not authorize inventing one."
      ]
    },
    {
      "id": "shop-buy-affordable-sale-card",
      "kind": "shop",
      "title": "Choose the explicitly affordable discounted card rather than an unaffordable card",
      "state": {
        "screen": "SHOP",
        "available_actions": ["buy_card", "close_shop_inventory"],
        "run": {"gold": 40},
        "shop": {
          "is_open": true,
          "cards": [
            {"index": 0, "card_id": "BENCHMARK_EXPENSIVE", "price": 75, "is_stocked": true, "enough_gold": false, "on_sale": false},
            {"index": 1, "card_id": "BENCHMARK_SALE", "price": 36, "is_stocked": true, "enough_gold": true, "on_sale": true}
          ]
        }
      },
      "expectations": [
        {"id": "buy-card-action", "kind": "action", "action": "buy_card", "points": 1},
        {"id": "buy-affordable-sale", "kind": "option_action", "action": "buy_card", "option_index": 1, "points": 3}
      ],
      "evidence": [
        "The shop payload exposes price, is_stocked, enough_gold, and on_sale; the fixture evaluates only those observable facts.",
        "This is not a universal card-tier claim: it deliberately does not rank unknown card text."
      ]
    },
    {
      "id": "reward-skip-low-value-card-choice",
      "kind": "reward",
      "title": "Permit the explicit skip branch when the fixture says no card is accepted",
      "state": {
        "screen": "REWARD",
        "available_actions": ["choose_reward_card", "skip_reward_cards"],
        "reward": {
          "pending_card_choice": true,
          "card_options": [
            {"index": 0, "card_id": "BENCHMARK_LOW_VALUE_A"},
            {"index": 1, "card_id": "BENCHMARK_LOW_VALUE_B"}
          ]
        }
      },
      "expectations": [
        {"id": "take-skip-action", "kind": "action", "action": "skip_reward_cards", "points": 3},
        {"id": "do-not-pick-first-by-default", "kind": "forbid_action", "action": "choose_reward_card", "points": 1}
      ],
      "evidence": [
        "Screen Playbooks §Reward: choose_reward_card and skip_reward_cards are the legal manual branches while pending_card_choice is true.",
        "This fixture makes no global card-value claim; its explicit label establishes a controlled skip decision for interface evaluation."
      ]
    },
    {
      "id": "reward-choose-indexed-card",
      "kind": "reward",
      "title": "Choose the explicitly supported reward-card option rather than an invented index",
      "state": {
        "screen": "REWARD",
        "available_actions": ["choose_reward_card", "skip_reward_cards"],
        "reward": {
          "pending_card_choice": true,
          "card_options": [
            {"index": 0, "card_id": "BENCHMARK_REWARD_A"},
            {"index": 3, "card_id": "BENCHMARK_REWARD_B"}
          ]
        }
      },
      "expectations": [
        {"id": "choose-reward-card-action", "kind": "action", "action": "choose_reward_card", "points": 1},
        {"id": "choose-supported-reward-index", "kind": "option_action", "action": "choose_reward_card", "option_index": 3, "points": 3}
      ],
      "evidence": [
        "Screen Playbooks §Reward: choose_reward_card takes an index from reward.card_options[].",
        "The fixture isolates selection-shape correctness and intentionally does not claim a card tier list."
      ]
    },
    {
      "id": "combat-legal-target-index",
      "kind": "combat",
      "title": "Use a declared legal enemy index for a target-required card",
      "state": {
        "screen": "COMBAT",
        "available_actions": ["play_card", "end_turn"],
        "combat": {
          "action_readiness": {"can_use_combat_actions": true},
          "hand": [
            {"index": 0, "card_id": "BENCHMARK_TARGET_CARD", "requires_target": true, "valid_target_indices": [1]}
          ],
          "enemies": [
            {"index": 0, "current_hp": 9, "is_alive": true},
            {"index": 1, "current_hp": 9, "is_alive": true}
          ]
        }
      },
      "expectations": [
        {"id": "play-a-card", "kind": "action", "action": "play_card", "points": 1},
        {"id": "select-targeted-card", "kind": "option_action", "action": "play_card", "option_index": 0, "points": 1},
        {"id": "select-only-legal-enemy", "kind": "target_action", "action": "play_card", "target_index": 1, "points": 1},
        {"id": "fixture-hand-is-actionable", "kind": "state_path", "path": "combat.action_readiness.can_use_combat_actions", "equals": true, "points": 0.5}
      ],
      "evidence": [
        "The target_action constraint scores target_index separately from the benchmark's neutral option_index field.",
        "The fixture retains valid_target_indices so a candidate runner can validate the full request before recording its answer."
      ]
    }
  ]
}
