    <!--
      A glob, not one file: NativeMcpServer is a partial class (transport in the base file, tool
      execution in NativeMcpServer.Tools.cs). Naming the base file alone compiled the class without
      its tools, and the failure arrived as "ReadString does not exist" rather than as a missing
      include. A new partial is picked up here without a second edit.
    -->
    <Compile Include="..\STS2AIAgent\Server\NativeMcpServer*.cs" Link="Server\%(Filename)%(Extension)" />
