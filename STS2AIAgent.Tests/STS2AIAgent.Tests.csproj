    <!--
      The screenshot sequence: gate, hide/restore pair, rendered-frame wait, read-back. Both files are
      Godot-free on purpose, so the offline suite compiles the real sequencing instead of a copy of
      it. The Godot half of the seam (ScreenshotService's host and its RenderingServer frame wait)
      cannot be linked here and is covered by the source contract in SessionControlContractTests.
    -->
    <Compile Include="..\STS2AIAgent\Agent\IScreenshotCaptureHost.cs" Link="Agent\IScreenshotCaptureHost.cs" />
    <Compile Include="..\STS2AIAgent\Agent\ScreenshotCapturePolicy.cs" Link="Agent\ScreenshotCapturePolicy.cs" />
    <!--
      The one-action lease. It reaches nothing from the game or Godot, only ApiException, so the
      offline suite compiles the real class and tests its own rules (first caller wins, everyone else
      is refused, no failure leaves it held) rather than a copy of them.
    -->
    <Compile Include="..\STS2AIAgent\Game\ActionExecutionGate.cs" Link="Game\ActionExecutionGate.cs" />
    <Compile Include="..\STS2AIAgent\Server\JsonHelper.cs" Link="Server\JsonHelper.cs" />
